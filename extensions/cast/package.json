{
  "name": "@ohif/extension-cast",
  "version": "3.13.0-beta.43",
  "description": "OHIF extension with vtk-backed CastService",
  "author": "OHIF",
  "license": "MIT",
  "repository": "OHIF/Viewers",
  "main": "dist/ohif-extension-cast.umd.js",
  "module": "src/index.tsx",
  "engines": {
    "node": ">=14",
    "npm": ">=6",
    "yarn": ">=1.18.0"
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "clean:deep": "yarn run clean && shx rm -rf node_modules",
    "dev": "cross-env NODE_ENV=development webpack --config .webpack/webpack.dev.js --watch --output-pathinfo",
    "build": "cross-env NODE_ENV=production webpack --config .webpack/webpack.prod.js"
  },
  "peerDependencies": {
    "@ohif/core": "3.13.0-beta.43"
  },
  "dependencies": {
    "@ohif/extension-default": "3.13.0-beta.43",
    "@babel/runtime": "7.28.2",
    "@cornerstonejs/core": "4.20.0",
    "@cornerstonejs/dicom-image-loader": "4.20.0",
    "@cornerstonejs/nifti-volume-loader": "4.20.0",
    "@kitware/vtk.js": "file:../../../vtk-js/dist/esm",
    "dcmjs": "0.49.4",
    "jszip": "3.10.1"
  }
}
